{
  // 在庫管理システム — Cloudflare Workers + D1 版 (無料・PCレス運用版)
  // 手順書は同ディレクトリの README.md を参照。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inventory-system-workers",
  "main": "src/index.ts",
  // ローカルの workerd (1.20260815) が受理できる上限に合わせている。定期的に引き上げること
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventory-system",
      // 2026-10-24 に API 経由で作成済み (database_id は識別子であり秘密情報ではない)
      "database_id": "d38d01ca-ab70-48a6-88cf-b9601133ec58",
      "migrations_dir": "migrations"
    }
  ],
  // 商品画像・検品写真の保存先。バケット inventory-images はデプロイ時に作成する。
  // ローカル (wrangler dev / テスト) では Miniflare が同名のローカルバケットを提供する
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "inventory-images"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INVENTORY_COORDINATOR",
        "class_name": "InventoryCoordinator"
      }
    ]
  },
  // Durable Object クラスの宣言 (exports 形式。旧来の migrations とは併用しない)
  "exports": {
    "InventoryCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    // IdP は Google (2026-10-24 決定)。いずれも公開情報のため vars に置く
    "OIDC_ISSUER_URL": "https://accounts.google.com",
    "OIDC_JWKS_URL": "https://www.googleapis.com/oauth2/v3/certs",
    "OIDC_AUDIENCE": "1099201950238-iq41o4dmf63nnitj43ifnfojqvtbip8s.apps.googleusercontent.com",
    "OIDC_CLIENT_ID": "1099201950238-iq41o4dmf63nnitj43ifnfojqvtbip8s.apps.googleusercontent.com"
  }
}
