# --- App ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL (prisma) ---
# ローカル開発: docker compose の PostgreSQL を指す。
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory?schema=public
# マイグレーション用 (schema.prisma の directUrl)。ローカルでは DATABASE_URL と同値でよい。
DIRECT_URL=postgresql://inventory:inventory@localhost:5432/inventory?schema=public
# 本番 (Neon) では以下の2つを使い分けること:
#   DATABASE_URL = アプリ実行時用。Neon の pooled 接続文字列 (ホスト名に -pooler を含むもの)。
#                  Prisma から pooler 経由で使う場合は ?pgbouncer=true を付ける。
#   DIRECT_URL   = prisma migrate deploy 用。Neon の direct 接続文字列 (pooler を介さないもの)。
#                  マイグレーションはプール経由では実行できないため、この使い分けが必須。

# --- Redis (Pub/Sub for realtime delivery) ---
# ローカル開発: docker compose の Redis を指す。
REDIS_URL=redis://localhost:6379
# 本番 (Upstash) では TLS 接続文字列を使う: REDIS_URL=rediss://<user>:<password>@<host>:<port>
# (redis:// ではなく rediss:// であることに注意)

# --- OIDC (IdP未確定のため汎用設定。製品固有値は書かない) ---
# 認証はIdPへ全面委任する。アプリ独自のパスワード認証は存在しない。
OIDC_ISSUER_URL=https://idp.example.com/
OIDC_AUDIENCE=inventory-system
# 省略時は {OIDC_ISSUER_URL}/.well-known/jwks.json を使用
OIDC_JWKS_URL=
OIDC_CLIENT_ID=inventory-system
